ssBar"><div class="progress-fill" id="progressFill"></div></div>\n <div class="controls">\n <button class="control-btn" id="listBtn" title="播放列表"><svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg></button>\n <button class="control-btn" id="playBtn" title="播放/暂停">\n <svg id="playSvg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>\n <svg id="pauseSvg" viewBox="0 0 24 24" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>\n </button>\n <button class="control-btn" id="nextBtn" title="下一首"><svg viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>\n </div>\n <div class="playlist-popup" id="listPopup">\n <div class="playlist-header"><span>播放列表</span><button class="close-popup-btn" id="closeListBtn"><svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button></div>\n <div id="listItems"></div>\n </div>\n</div>\n<audio id="audio" preload="metadata"></audio>\n<script>\nconst mask=document.getElementById(\'mask\'),closeBtn=document.getElementById(\'closeBtn\'),countdownEl=document.getElementById(\'countdown\');\nlet cd=5;const timer=setInterval(()=>{\n cd--;\n countdownEl.textContent=cd>0?`${cd}秒后可关闭`:\'关闭\';\n if(cd<=0){\n clearInterval(timer);\n closeBtn.classList.add(\'ready\');\n }\n},1000);\ncloseBtn.onclick=()=>{\n if(closeBtn.classList.contains(\'ready\')){\n mask.style.display=\'none\';\n playSong(0);\n }\n};\nconst playlist=[\n{name:\'坏女孩\',url:\'https://www.sekaiplan.com/upload/bad-girl.mp3\'},\n{name:\'星光尽头\',url:\'https://www.sekaiplan.com/upload/until-the-end.mp3\'},\n{name:\'三国杀\',url:\'https://www.sekaiplan.com/upload/sanguosha.mp3\'},\n{name:\'Flames\',url:\'https://www.sekaiplan.com/upload/flames.mp3\'},\n{name:\'Higher\',url:\'https://www.sekaiplan.com/upload/higher.mp3\'},\n{name:\'Higher Now\',url:\'https://www.sekaiplan.com/upload/higher-now.mp3\'},\n{name:\'打上花火\',url:\'https://www.sekaiplan.com/upload/fireworks.mp3\'},\n{name:\'向夜晚奔去\',url:\'https://www.sekaiplan.com/upload/Into-the-night.mp3\'},\n];\nconst audio=document.getElementById(\'audio\'),miniBtn=document.getElementById(\'miniBtn\'),widget=document.getElementById(\'widget\'),playBtn=document.getElementById(\'playBtn\'),playSvg=document.getElementById(\'playSvg\'),pauseSvg=document.getElementById(\'pauseSvg\'),nextBtn=document.getElementById(\'nextBtn\'),listBtn=document.getElementById(\'listBtn\'),listPopup=document.getElementById(\'listPopup\'),closeListBtn=document.getElementById(\'closeListBtn\'),progressBar=document.getElementById(\'progressBar\'),progressFill=document.getElementById(\'progressFill\'),widgetTitle=document.getElementById(\'widgetTitle\');\nlet currentIndex=-1,playing=false;\nfunction renderList(){\n const box=document.getElementById(\'listItems\');\n box.innerHTML=\'\';\n playlist.forEach((song,i)=>{\n const row=document.createElement(\'div\');\n row.className=\'playlist-item\';\n row.innerHTML=`<span>${song.name}</span><button class="play-now-btn" data-i="${i}">播放</button>`;\n box.appendChild(row);\n });\n box.onclick=e=>{\n if(e.target.classList.contains(\'play-now-btn\')){\n playSong(parseInt(e.target.dataset.i));\n listPopup.classList.remove(\'active\');\n }\n };\n}\nrenderList();\nfunction playSong(index){\n if(index<0||index>=playlist.length)return;\n currentIndex=index;\n audio.src=playlist[index].url;\n audio.play().catch(()=>{});\n playing=true;\n updatePlayIcon();\n widgetTitle.textContent=playlist[index].name;\n miniBtn.classList.add(\'playing\');\n}\nplayBtn.onclick=()=>{\n if(currentIndex===-1)return playSong(0);\n if(playing){\n audio.pause();\n playing=false;\n }else{\n audio.play().catch(()=>{});\n playing=true;\n }\n updatePlayIcon();\n};\nnextBtn.onclick=()=>playSong((currentIndex+1)%playlist.length);\nlistBtn.onclick=()=>listPopup.classList.toggle(\'active\');\ncloseListBtn.onclick=()=>listPopup.classList.remove(\'active\');\naudio.addEventListener(\'timeupdate\',()=>progressFill.style.width=(audio.currentTime/audio.duration*100||0)+\'%\');\naudio.addEventListener(\'ended\',()=>playSong((currentIndex+1)%playlist.length));\nprogressBar.addEventListener(\'click\',e=>{\n const rect=progressBar.getBoundingClientRect();\n audio.currentTime=((e.clientX-rect.left)/rect.width)*audio.duration;\n});\nfunction updatePlayIcon(){\n playSvg.style.display=playing?\'none\':\'block\';\n pauseSvg.style.display=playing?\'block\':\'none\';\n if(playing){\n miniBtn.classList.add(\'playing\');\n }else{\n miniBtn.classList.remove(\'playing\');\n }\n}\nfunction syncWidgetPos(){\n const r=miniBtn.getBoundingClientRect();\n widget.style.left=(r.left-226)+\'px\';\n widget.style.top=r.top+\'px\';\n widget.style.right=\'auto\';\n widget.style.bottom=\'auto\';\n}\nfunction collapseWidget(){\n widget.classList.remove(\'active\');\n}\nminiBtn.onclick=(e)=>{\n e.stopPropagation();\n if(widget.classList.contains(\'active\')){\n collapseWidget();\n return;\n }\n widget.classList.add(\'active\');\n syncWidgetPos();\n correctBoundary(widget);\n};\nwidgetTitle.onclick=()=>collapseWidget();\ndocument.addEventListener(\'click\',e=>{\n if(widget.classList.contains(\'active\') &&\n !widget.contains(e.target) &&\n !miniBtn.contains(e.target)){\n collapseWidget();\n }\n});\nfunction makeDraggable(el){\n let dragging=false,offsetX=0,offsetY=0,rAF=false;\n el.addEventListener(\'pointerdown\',e=>{\n dragging=true;\n const r=el.getBoundingClientRect();\n offsetX=e.clientX-r.left;\n offsetY=e.clientY-r.top;\n el.setPointerCapture(e.pointerId);\n el.style.cursor=\'grabbing\';\n });\n el.addEventListener(\'pointermove\',e=>{\n if(!dragging)return;\n if(!rAF){\n requestAnimationFrame(()=>moveEl(e));\n rAF=true;\n }\n });\n function moveEl(e){\n let x=e.clientX-offsetX,y=e.clientY-offsetY;\n el.style.left=x+\'px\';\n el.style.top=y+\'px\';\n el.style.right=\'auto\';\n el.style.bottom=\'auto\';\n correctBoundary(el);\n if(el===miniBtn && widget.classList.contains(\'active\'))syncWidgetPos();\n rAF=false;\n }\n el.addEventListener(\'pointerup\',e=>{\n dragging=false;\n el.releasePointerCapture(e.pointerId);\n el.style.cursor=\'grab\';\n });\n}\nfunction correctBoundary(el){\n const r=el.getBoundingClientRect();\n let x=r.left,y=r.top;\n if(r.right>window.innerWidth)x=window.innerWidth-r.width;\n if(r.left<0)x=0;\n if(r.bottom>window.innerHeight)y=window.innerHeight-r.height;\n if(r.top<0)y=0;\n el.style.left=x+\'px\';\n el.style.top=y+\'px\';\n}\nmakeDraggable(miniBtn);\n</script>\n</body>\n</html>')

